# ArkLink 配置示例 —— 这些片段放进 ArkBot 的 bot.toml
# 前提：pip install arklink（或用点分路径，见下）

# ---------- 1. Milky（推荐：能力强、生态新） ----------
[[adapters]]
type = "milky"
base_url = "http://127.0.0.1:3000"     # 协议端地址，务必只监听 127.0.0.1
access_token = "change-me"
# event_url = "ws://127.0.0.1:3000/event"   # 默认由 base_url 推导
reconnect_interval = 3.0
max_backoff = 60.0

# ---------- 2. Satori（Koishi / Chronocat） ----------
# [[adapters]]
# type = "satori"
# api_base = "http://127.0.0.1:5140"
# token = "change-me"
# platform = "qq"
# user_id = ""                          # 可留空，READY 后自动填

# ---------- 3. 原生协议（研究态，不登录） ----------
# [[adapters]]
# type = "ntqq-native"
# uin = 10001
# signer_url = "http://127.0.0.1:8080"
# allow_login = false                   # 置 true 也只是打印缺失清单

# ---------- 3.5 操作已登录的官方客户端（最后一条通知腿） ----------
# 只发文本、只发不收；客户端在线即算健康，不碰 QQ 内部，不注入
# [[adapters]]
# type = "ntqq-client"
# dry_run = false                      # 默认 true：只记录不敲键盘，校准后再关
# search_hotkey = "^f"                 # QQ NT 搜索；个别版本是 "^+f"
# paste_hotkey = "^v"
# process_names = ["QQ.exe"]

